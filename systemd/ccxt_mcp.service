[Unit]
Description=ccxt MCP server - Crypto MCP Server (Corax CoLAB)
After=network.target

[Service]
Type=simple
# User=pelle (Run as current user or specific user)
WorkingDirectory=%h/Crypto-MCP-Server---by-Corax-CoLAB
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/Crypto-MCP-Server---by-Corax-CoLAB/.env
ExecStart=%h/Crypto-MCP-Server---by-Corax-CoLAB/.venv/bin/python %h/Crypto-MCP-Server---by-Corax-CoLAB/ccxt_mcp.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
